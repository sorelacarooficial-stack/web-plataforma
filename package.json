{
  "name": "sorela-divine-web",
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "private": true,
  "description": "Web pública de Sorela Caro · Técnica Divine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "fotos": "node scripts/optimizar-imagenes.mjs",
    "mapa": "node scripts/preparar-mapa.mjs",
    "capturas": "node pruebas/capturas.mjs",
    "manuales": "node --env-file=.env.local docs/capturas.mjs && node docs/optimizar.mjs && node docs/generar.mjs",
    "pruebas": "node --env-file=.env.local pruebas/interacciones.mjs",
    "pruebas:todas": "npm run pruebas && npm run pruebas:home && npm run pruebas:inicio && npm run pruebas:menu && npm run pruebas:auditoria && npm run pruebas:asistente && npm run pruebas:hero && npm run pruebas:acceso && npm run pruebas:plataforma && npm run pruebas:agenda",
    "pruebas:plataforma": "node --env-file=.env.local pruebas/plataforma.mjs",
    "pruebas:agenda": "node --env-file=.env.local pruebas/agenda.mjs",
    "pruebas:acceso": "node --env-file=.env.local pruebas/acceso.mjs",
    "pruebas:firebase": "node --env-file=.env.local pruebas/firebase.mjs",
    "pruebas:asistente": "node pruebas/asistente.mjs",
    "pruebas:menu": "node --env-file=.env.local pruebas/menu.mjs",
    "pruebas:auditoria": "node pruebas/auditoria.mjs",
    "pruebas:home": "node pruebas/home.mjs",
    "pruebas:hero": "node pruebas/hero.mjs",
    "pruebas:inicio": "node pruebas/inicio-nuevo.mjs",
    "pruebas:captacion": "node --env-file=.env.local pruebas/captacion.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "playwright": "^1.57.0",
    "typescript": "^5.7.2",
    "world-atlas": "^2.0.2"
  },
  "overrides": {
    "jose": "^5.10.0"
  }
}
